# The OpenRC image of tests/boot.sh: Alpine with busybox init running
# OpenRC (Alpine's own /sbin/init and inittab, without the gettys on
# virtual terminals a container machine does not have), busybox's crond,
# and a service that checks the boot once it is done. The base is pinned
# by digest; the packages are Alpine's current ones (they only drive the
# checks).
FROM docker.io/library/alpine@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN apk add --no-cache openrc busybox-openrc
COPY init-features.sh /usr/local/bin/init-features.sh
COPY init-features.openrc /etc/init.d/init-features
RUN sed -i '/^tty[0-9]*::/d' /etc/inittab \
 && chmod 0755 /usr/local/bin/init-features.sh /etc/init.d/init-features \
 && rc-update add crond default \
 && rc-update add init-features default
