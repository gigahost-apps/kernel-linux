# The trim, on top of 10-container.config: what a container machine never
# uses (FIPS, crypto self-tests, debugging, audit, LSMs, SCSI, USB, VT,
# input, CPU frequency), zstd compression, and fw_cfg in sysfs for the
# init's config.
# --- crypto: no FIPS mode, no boot-time self-tests ---
# CONFIG_CRYPTO_FIPS is not set
# CONFIG_CRYPTO_SELFTESTS is not set
# CONFIG_CRYPTO_SELFTESTS_FULL is not set
# --- debugging (DEBUG_KERNEL itself is selected by EXPERT, which VT=n and
#     INPUT=n need; everything that hangs off it goes) ---
# CONFIG_DEBUG_BUGVERBOSE is not set
# CONFIG_DEBUG_MISC is not set
# CONFIG_DEBUG_LIST is not set
# CONFIG_DEBUG_MEMORY_INIT is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_BLK_DEBUG_FS is not set
# CONFIG_JBD2_DEBUG is not set
# CONFIG_PNP_DEBUG_MESSAGES is not set
# CONFIG_LOCKUP_DETECTOR is not set
# CONFIG_SOFTLOCKUP_DETECTOR is not set
# CONFIG_HARDLOCKUP_DETECTOR is not set
# CONFIG_DETECT_HUNG_TASK is not set
# CONFIG_WQ_WATCHDOG is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_KALLSYMS_ALL is not set
# --- audit and LSMs (seccomp and namespaces need none of them) ---
# CONFIG_AUDIT is not set
# CONFIG_SECURITY is not set
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_SECURITY_LANDLOCK is not set
# CONFIG_SECURITY_YAMA is not set
# CONFIG_SECURITY_APPARMOR is not set
# CONFIG_SECURITY_SMACK is not set
# CONFIG_SECURITY_TOMOYO is not set
# CONFIG_SECURITY_LOADPIN is not set
# CONFIG_SECURITY_SAFESETID is not set
# CONFIG_SECURITY_LOCKDOWN_LSM is not set
# CONFIG_BPF_LSM is not set
# CONFIG_INTEGRITY is not set
# --- devices the container VM does not have ---
# CONFIG_SCSI is not set
# CONFIG_BLK_DEV_BSG is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_VT is not set
# CONFIG_INPUT is not set
# CONFIG_SERIO is not set
# CONFIG_FB is not set
# CONFIG_DRM is not set
# CONFIG_SOUND is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_BT is not set
# CONFIG_HID_SUPPORT is not set
# --- ACPI: keep the core (power-off) and drop what pc does not use ---
CONFIG_ACPI=y
# CONFIG_SCHED_MC_PRIO is not set
# CONFIG_X86_INTEL_PSTATE is not set
# CONFIG_X86_AMD_PSTATE is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_ACPI_PROCESSOR is not set
# CONFIG_ACPI_CONTAINER is not set
# CONFIG_ACPI_HOTPLUG_MEMORY is not set
# CONFIG_ACPI_PCC is not set
# CONFIG_ACPI_PLATFORM_PROFILE is not set
# CONFIG_ACPI_FAN is not set
# CONFIG_ACPI_THERMAL is not set
# CONFIG_ACPI_BUTTON is not set
# CONFIG_ACPI_AC is not set
# CONFIG_ACPI_BATTERY is not set
# CONFIG_ACPI_VIDEO is not set
# --- compression: zstd boots faster than gzip and xz ---
# CONFIG_KERNEL_GZIP is not set
CONFIG_KERNEL_ZSTD=y
# --- what the init needs ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_FW_CFG_SYSFS=y
